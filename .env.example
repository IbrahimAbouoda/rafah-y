# انسخ هذا الملف إلى .env.local (للتطبيق) و .env (لأوامر Prisma).
# القيم المحلية تظهر بعد `npx supabase start`.

# Supabase — ما يبدأ بـ NEXT_PUBLIC_ علنيٌّ بحكم التعريف (PRD §6.10)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# التطبيق: عبر الـ pooler في الإنتاج · محليًا نفس الرابط المباشر
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# أوامر Prisma migrate: اتصال مباشر دائمًا
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# مفتاح تشفير بيانات التواصل — 32 بايت base64، خارج قاعدة البيانات (PRD §6.6)
# توليد: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONTACT_ENCRYPTION_KEY=

# رابط التطبيق (روابط البريد: استعادة كلمة المرور)
APP_URL=http://localhost:3000

# حد المعدل (PRD §6.4 · D11). إلزامية في الإنتاج: بدونها تُرفض الإجراءات المحدودة (فشل مغلق — H-2).
# فارغة في التطوير = ذاكرة LRU داخل العملية. RATE_LIMIT_STORE=memory لتجربة بناء الإنتاج محليًا فقط.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_STORE=

# عنوان العميل لحدود المعدل (H-1). IP_HEADER: رأس تضبطه منصة الاستضافة ولا يزوّره العميل (مثل x-real-ip على Vercel).
# بدونه: X-Forwarded-For من اليمين بعدد الوكلاء الموثوقين (الافتراضي 1) — أول قيمة يكتبها العميل ولا يُوثق بها.
IP_HEADER=
TRUSTED_PROXY_HOPS=1

# Supabase Storage على الخادم فقط — لا يبدأ بـ NEXT_PUBLIC_ (PRD §6.5 · §6.10)
# محليًا: SERVICE_ROLE_KEY من `npx supabase status -o env`
SUPABASE_SERVICE_ROLE_KEY=

# البريد الصادر — المرسِل دائمًا info.rafahyouth@gmail.com (PRD §19.3 D19)
# محليًا: Mailpit من Supabase (smtp_port في supabase/config.toml · الواجهة http://127.0.0.1:54324)
# الإنتاج: SMTP_HOST=smtp.gmail.com · SMTP_PORT=465 · SMTP_USER=info.rafahyouth@gmail.com · SMTP_PASS=كلمة مرور تطبيق Gmail
# فارغ = لا إرسال؛ تبقى إشعارات البريد PENDING ولا يتعطل أي إجراء
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=
